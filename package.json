{
  "name": "4096-square-game",
  "version": "1.0.0",
  "description": "4096 Square Game - A challenging number puzzle game",
  "private": true,
  "scripts": {
    "build": "mkdir -p www && cp index.html www/index.html",
    "cap:sync": "npx cap sync",
    "cap:sync:ios": "npx cap sync ios",
    "cap:sync:android": "npx cap sync android",
    "cap:open": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "prepare": "npm run build && npm run cap:sync"
  },
  "keywords": [
    "game",
    "puzzle",
    "4096",
    "2048"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/ios": "^8.2.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.2.0",
    "typescript": "^5.9.3"
  }
}
